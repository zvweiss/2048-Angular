{
  "name": "app",
  "version": "0.0.0",
  "scripts": {
  "ng": "npx ng",
  "start": "npx ng serve",
  "build": "npx ng build --base-href=/2048-Angular/",
  "build:prod": "npx ng build --configuration production --base-href=/2048-Angular/",
  "deploy": "npm run build:prod && touch dist/2048-angular/browser/.nojekyll && npx gh-pages -d dist/2048-angular/browser --dotfiles",
  "watch": "npx ng build --watch --configuration development",
  "kill-port": "kill-port 4200",
  "test": "npx ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/animations": "^21.0.6",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "angular-cli-ghpages": "^2.0.3",
    "gh-pages": "^6.3.0",
    "typescript": "~5.9.2"
  }
}
